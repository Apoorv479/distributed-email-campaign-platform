{
  "name": "distributed-email-campaign-platform",
  "version": "1.0.0",
  "description": "A distributed email campaign platform built with Node.js, TypeScript, BullMQ and Redis",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
