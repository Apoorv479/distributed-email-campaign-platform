{
  "name": "distributed-email-campaign-platform",
  "version": "1.0.0",
  "description": "A distributed email campaign platform built with Node.js, TypeScript, BullMQ and Redis",
  "type": "module",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "worker:email": "tsx src/workers/email.worker.ts",
  "build": "tsc",
  "start": "node dist/server.js",
  "typecheck": "tsc --noEmit"
},
  "keywords": [
    "email",
    "campaign",
    "bullmq",
    "redis",
    "distributed-systems",
    "job-queue",
    "typescript",
    "nodejs"
  ],
  "author": "Apoorv Jha",
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
